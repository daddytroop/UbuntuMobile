<?xml version="1.0" encoding="utf-8"?>
<!--
  A terminal window: a white title bar with window dots over an aubergine
  console with a prompt. Everything sits inside the adaptive icon's safe
  zone (the middle 66dp), so no launcher mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- shadow -->
    <path
        android:pathData="M37,37h38a6,6 0,0 1,6 6v28a6,6 0,0 1,-6 6h-38a6,6 0,0 1,-6 -6v-28a6,6 0,0 1,6 -6z"
        android:fillColor="#33000000" />

    <!-- window: title bar -->
    <path
        android:pathData="M35,34h38a6,6 0,0 1,6 6v4h-50v-4a6,6 0,0 1,6 -6z"
        android:fillColor="#FFFFFFFF" />

    <!-- window: console -->
    <path
        android:pathData="M29,44h50v24a6,6 0,0 1,-6 6h-38a6,6 0,0 1,-6 -6z"
        android:fillColor="#FF2C0A26" />

    <!-- window dots -->
    <path
        android:pathData="M36,39m-1.8,0a1.8,1.8 0,1 1,3.6 0a1.8,1.8 0,1 1,-3.6 0"
        android:fillColor="#FFE95420" />
    <path
        android:pathData="M41.5,39m-1.8,0a1.8,1.8 0,1 1,3.6 0a1.8,1.8 0,1 1,-3.6 0"
        android:fillColor="#FFD9D2D6" />
    <path
        android:pathData="M47,39m-1.8,0a1.8,1.8 0,1 1,3.6 0a1.8,1.8 0,1 1,-3.6 0"
        android:fillColor="#FFD9D2D6" />

    <!-- prompt: > -->
    <path
        android:pathData="M37,51.5l7,5.5l-7,5.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- prompt: _ -->
    <path
        android:pathData="M49,63h12"
        android:strokeColor="#FFF26B2E"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />
</vector>
