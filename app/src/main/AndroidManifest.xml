<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Installing a new version of Mobuntu over itself (AppUpdate). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The Wi-Fi signal, for the Linux panel's network item. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Quick settings on the desktop: switching Wi-Fi and Bluetooth. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The microphone, for Linux apps that record (MicBridge.kt); asked for
         the first time one does. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Linux keeps running while the app is not on screen (LinuxService.kt),
         awake on request, and with the battery optimisation lifted when the
         user allows it (Settings). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
      The phone's folders (Downloads, Documents, ...) appear in the Linux home
      folder. The app targets API 28, so these still grant the legacy access
      to shared storage on every Android version.
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.vulkan.version" android:required="false" />

    <application
        android:name=".UbuntuApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.UbuntuMobile"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:extractNativeLibs="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|uiMode"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden"
            android:theme="@style/Theme.UbuntuMobile">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open in Mobuntu": files, text and links from other apps
                 open in a Linux app (SharedIn.kt). -->
            <intent-filter android:label="Open in Mobuntu">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="Open in Mobuntu">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- Mobuntu as the phone's home screen: off until the user turns it on
             (HomeScreen.kt enables it and asks Android to make it the default).
             It only brings MainActivity forward (HomeActivity.kt), from a task
             of its own: in the same task, Home would close MainActivity. -->
        <activity
            android:name=".HomeActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity="${applicationId}.home"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The phone's notifications on the Linux desktop, once allowed. -->
        <service
            android:name=".linux.PhoneNotifications"
            android:exported="true"
            android:label="Phone notifications on the Linux desktop"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".linux.LinuxService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Android's answers while it installs a new version (AppUpdate). -->
        <receiver
            android:name=".linux.AppUpdate$Receiver"
            android:exported="false" />
        <!-- After an update: a notification to open the app again. -->
        <receiver
            android:name=".linux.AppUpdate$Updated"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
