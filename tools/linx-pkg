#!/bin/bash
# Install lines copied from the web, made to work here. Runs inside the
# container, as root, from a terminal.
#
# Instructions for installing a Linux app usually start with "sudo", and
# are as often written for Arch (pacman, yay), Fedora (dnf) or snap as for
# Ubuntu; a Flathub line may name an app that Flathub builds only for PCs.
# Typed into Mobuntu's terminal they ended in "command not found" or
# "nothing matches". This is what answers instead:
#
#   sudo CMD...            there is no other user: runs CMD (as root)
#   pacman -S NAME...      yay, paru, dnf, yum, zypper, apk, snap likewise:
#                          the same thing done with apt, the name put
#                          Ubuntu's way (python-pip is python3-pip here),
#                          and from Flathub when Ubuntu does not have it
#   flatpak install NAME   a plain name finds the app's id; Flathub is set
#                          up first if it is not; an app that is not
#                          built for this processor is said to be so
#   linx-pkg install NAME  the same search, by hand
#   steam                  Steam runs in DroidDeck on ARM phones: opens it
#
# Some apps need more than a name (special_case): Steam and Spotify have
# no build that runs here; Ubuntu's own thunderbird and chromium packages
# are stubs that install a snap, which cannot run here, so those come
# from Flathub; Discord and Thunderbird have ARM stand-ins there.
#
# The app installs it as /usr/local/bin/linx-pkg and a two-line shim per
# name (sudo, pacman, ...; ContainerSetup.SHIMS), never over a real one.
# In a terminal, linx-shell.sh also sends "flatpak install", a failed
# "apt install" and unknown commands here.
set -u
APT=/usr/local/lib/linx/apt-install.sh
FLATPAK=/usr/bin/flatpak
ME="${LINX_AS:-}"
# Not for what this starts: "sudo pacman" is pacman's turn next.
unset LINX_AS

say() { printf '\033[1;35m::\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m::\033[0m %s\n' "$*" >&2; }

# ------------------------------------------------------------------ names
# Other distributions' names for what Ubuntu calls something else. The
# AUR's -bin and -git endings mean nothing here and are dropped.
ubuntu_name() {
  local n="${1,,}"
  n="${n%-bin}"; n="${n%-git}"
  case "$n" in
    base-devel | build-base | "@development-tools") echo build-essential ;;
    python | python3) echo python3 ;;
    python-pip | py3-pip | python3-pip | pip) echo python3-pip ;;
    python-virtualenv) echo python3-venv ;;
    python-*) echo "python3-${n#python-}" ;;
    go | golang) echo golang-go ;;
    jdk-openjdk | java-latest-openjdk | openjdk) echo default-jdk ;;
    jre-openjdk) echo default-jre ;;
    openssh) echo openssh-client ;;
    nodejs-lts-* | node) echo nodejs ;;
    imagemagick7) echo imagemagick ;;
    github-cli) echo gh ;;
    docker-compose) echo docker-compose-v2 ;;
    gvim) echo vim-gtk3 ;;
    ttf-* | noto-fonts*) echo "$n" ;;
    *) echo "$n" ;;
  esac
}

# Apps better taken from Flathub (or not in Ubuntu's archive at all).
flathub_id() {
  case "${1,,}" in
    code | vscode | visual-studio-code) echo com.visualstudio.code ;;
    vscodium | codium) echo com.vscodium.codium ;;
    telegram | telegram-desktop) echo org.telegram.desktop ;;
    signal | signal-desktop) echo org.signal.Signal ;;
    spotify) echo com.spotify.Client ;;
    discord) echo com.discordapp.Discord ;;
    obs | obs-studio) echo com.obsproject.Studio ;;
    retroarch) echo org.libretro.RetroArch ;;
    chromium) echo org.chromium.Chromium ;;
    *) return 1 ;;
  esac
}

have_lists() { ls /var/lib/apt/lists/*_Packages* >/dev/null 2>&1; }
in_ubuntu() {
  local c
  c="$(apt-cache policy "$1" 2>/dev/null | sed -n 's/^ *Candidate: //p')"
  # A version like "2:1snap1-0ubuntu5" is a stub that installs a snap.
  case "$c" in "" | "(none)" | *snap*) return 1 ;; esac
}

# (LINX_ARCH: for trying another processor's answers.)
case "${LINX_ARCH:-$(uname -m)}" in
  aarch64 | arm*) ARM=1 ;;
  *) ARM=0 ;;
esac

# special_case NAME: apps that need more than a name. Prints why, and
# returns 0 with REDIRECT set to a Flathub id to install instead, or to
# nothing when there is nothing to install; returns 1 for any other name.
REDIRECT=""
special_case() {
  REDIRECT=""
  case "${1,,}" in
    steam | steam-installer | steam-launcher | steamcmd | com.valvesoftware.steam | steamlink | steam-link | com.valvesoftware.steamlink)
      [ "$ARM" = 1 ] || return 1
      warn "Steam cannot run inside Mobuntu on this phone: it needs Valve's ARM build, a translator for PC code and the phone's graphics chip."
      warn "It runs in DroidDeck, a separate free app that has all three. Type:  steam"
      warn "(opens DroidDeck, or the page to get it from). It is also under All apps in Mobuntu." ;;
    spotify | spotify-client | spotify-launcher | com.spotify.client)
      [ "$ARM" = 1 ] || return 1
      warn "Spotify makes its Linux app only for PCs. On this phone: open.spotify.com in Firefox, or the phone's own Spotify app." ;;
    thunderbird | org.mozilla.thunderbird)
      if [ "$ARM" = 1 ]; then
        say "Thunderbird is built only for PCs on Flathub (and Ubuntu's package is a snap, which cannot run here). Betterbird is Thunderbird, built for ARM too."
        REDIRECT=eu.betterbird.Betterbird
      else
        say "Ubuntu's thunderbird package is a snap, which cannot run here: taking Thunderbird from Flathub."
        REDIRECT=org.mozilla.Thunderbird
      fi ;;
    chromium | chromium-browser)
      say "Ubuntu's chromium package is a snap, which cannot run here: taking Chromium from Flathub."
      REDIRECT=org.chromium.Chromium ;;
    google-chrome | google-chrome-stable | chrome | com.google.chrome)
      [ "$ARM" = 1 ] || return 1
      say "Google makes Chrome for Linux only for PCs. Chromium is the same browser without Google's additions."
      REDIRECT=org.chromium.Chromium ;;
    discord | com.discordapp.discord)
      [ "$ARM" = 1 ] || return 1
      say "Discord makes its Linux app only for PCs. Vesktop is a Discord app built for ARM too."
      REDIRECT=dev.vencord.Vesktop ;;
    *) return 1 ;;
  esac
  return 0
}

# Things that install but cannot do their job here: said, not stopped.
note_about() {
  case "${1,,}" in
    docker | docker.io | docker-ce | docker-desktop | podman | lxc | lxd)
      warn "Note: containers need parts of the kernel that Android keeps from apps, so $1 can be installed but cannot run containers here." ;;
    wine | wine-stable | winehq-stable | lutris | bottles | heroic)
      [ "$ARM" = 1 ] && warn "Note: Windows programs are built for PC processors; most will not run on this phone." ;;
    virtualbox | qemu-kvm | virt-manager | gnome-boxes)
      warn "Note: virtual machines need hardware access Android does not give apps; expect them to be very slow or not to start." ;;
  esac
}
flathub_ready() { "$FLATPAK" remotes 2>/dev/null | grep -q '^flathub'; }
on_flathub() { ! "$FLATPAK" remote-info flathub "$1" 2>&1 >/dev/null | grep -qiE "nothing matches|can.t find ref"; }

# The processors Flathub builds an app for ("x86_64 aarch64"), or nothing
# if it has no such app (or cannot be asked).
flathub_arches() {
  curl -fsS -m 15 "https://flathub.org/api/v2/summary/$1" 2>/dev/null |
    python3 -c 'import json,sys; print(" ".join(json.load(sys.stdin).get("arches") or []))' 2>/dev/null
}

# find_flathub WORD: prints "id<TAB>name" for the apps Flathub's search
# gives, the one whose name or id is WORD first.
find_flathub() {
  "$FLATPAK" search --columns=application,name "$1" 2>/dev/null | awk -F'\t' -v w="${1,,}" '
    NF >= 2 && $1 ~ /\./ && $1 !~ /\.(Platform|Sdk|Plugin|Extension|Locale|Debug)(\.|$)/ {
      id = $1; name = $2; n = split(id, part, ".")
      exact = (tolower(name) == w || tolower(part[n]) == w || tolower(id) == w) ? 0 : 1
      print exact "\t" id "\t" name
    }' | sort -s -k1,1 | cut -f2- | head -n 5
}

# near_ubuntu WORD: Ubuntu's packages with WORD in the name, programs
# first (not libraries or their development files).
near_ubuntu() {
  apt-cache search --names-only "$1" 2>/dev/null |
    awk -v w="${1,,}" 'index($1, w) && $1 !~ /^lib|-dev$|-doc$|-dbg$|-data$|-common$/' | head -n 4
}

suggest() {
  local name="$1" debs flats="" word
  debs="$(near_ubuntu "$name")"
  flathub_ready && flats="$(find_flathub "$name")"
  # Nothing at all: perhaps a letter too many (gimpp), so one less.
  if [ -z "$debs$flats" ] && [ "${#name}" -gt 4 ]; then
    word="${name%?}"
    debs="$(near_ubuntu "$word")"
    flathub_ready && flats="$(find_flathub "$word")"
  fi
  if [ -n "$debs" ]; then
    warn "Ubuntu has these with a similar name (apt install NAME):"
    printf '%s\n' "$debs" | sed 's/^/     /' >&2
  fi
  if [ -n "$flats" ]; then
    warn "Flathub has these (flatpak install ID):"
    printf '%s\n' "$flats" | sed 's/\t/   /; s/^/     /' >&2
  fi
  if [ -z "$debs$flats" ]; then
    warn "Nothing with a similar name either. Check the spelling, or search: linx-pkg search WORD"
  else
    warn "The Software store in Mobuntu searches both."
  fi
}

# ---------------------------------------------------------------- flatpak
# install_flatpaks [flatpak's own options] REF...: resolves names to ids,
# then installs them from Flathub.
install_flatpaks() {
  local opts=() refs=() a id arches match rc=0
  for a in "$@"; do
    case "$a" in
      -*) opts+=("$a") ;;
      flathub) ;;
      *) refs+=("$a") ;;
    esac
  done
  [ "${#refs[@]}" -gt 0 ] || exec "$FLATPAK" install "${opts[@]}"
  if ! flathub_ready; then
    say "Setting Flathub up first (once)..."
    /usr/local/lib/linx/linx-flatpak.sh >/tmp/linx-flatpak-terminal.log 2>&1 ||
      { warn "Flathub could not be set up: $(tail -n 1 /tmp/linx-flatpak-terminal.log)"; return 1; }
  fi
  local arch
  arch="$("$FLATPAK" --default-arch 2>/dev/null)"
  local ids=()
  for a in "${refs[@]}"; do
    id="$a"
    case "$a" in
      *.*.*) ;;
      *)
        # A plain name: Flathub's search finds the id.
        if special_case "$a"; then
          if [ -z "$REDIRECT" ]; then rc=1; continue; fi
          ids+=("$REDIRECT")
          continue
        fi
        match="$(find_flathub "$a" | head -n 1)"
        id="$(flathub_id "$a" 2>/dev/null || printf '%s' "${match%%$'\t'*}")"
        if [ -z "$id" ]; then
          warn "Flathub has no app called \"$a\"."
          in_ubuntu "$(ubuntu_name "$a")" && warn "Ubuntu has it: apt install $(ubuntu_name "$a")"
          rc=1
          continue
        fi
        say "$a is $id on Flathub"
        ;;
    esac
    if special_case "$id"; then
      if [ -z "$REDIRECT" ]; then rc=1; continue; fi
      id="$REDIRECT"
    fi
    if ! on_flathub "$id"; then
      # Ids are case-sensitive: org.videolan.vlc is org.videolan.VLC.
      match="$(find_flathub "${id##*.}" | awk -F'\t' -v w="${id,,}" 'tolower($1) == w { print $1; exit }')"
      if [ -n "$match" ] && on_flathub "$match"; then
        say "$id is written $match on Flathub"
        ids+=("$match")
        continue
      fi
      arches="$(flathub_arches "$id")"
      if [ -n "$arches" ]; then
        warn "$id is on Flathub only for: $arches. This device is $arch, so it cannot be installed here."
      else
        warn "Flathub has no app with the id $id (check the spelling)."
        match="$(find_flathub "${id##*.}")"
        [ -n "$match" ] && { warn "Did you mean:"; printf '%s\n' "$match" | sed 's/\t/   /; s/^/     /' >&2; }
      fi
      a="$(ubuntu_name "${id##*.}")"
      in_ubuntu "$a" && warn "Ubuntu has \"$a\": apt install $a"
      rc=1
      continue
    fi
    ids+=("$id")
  done
  [ "${#ids[@]}" -gt 0 ] || return "$rc"
  "$FLATPAK" install "${opts[@]}" flathub "${ids[@]}" || rc=$?
  return "$rc"
}

# ------------------------------------------------------------------- apt
# install_names NAME...: each from Ubuntu if it has it, else from Flathub.
install_names() {
  local debs=() flats=() name deb id rc=0
  # Ubuntu's package lists, the first time.
  have_lists || { say "Getting Ubuntu's package lists (once)..."; "$APT" --search xyzzy >/dev/null 2>&1; }
  for name in "$@"; do
    case "${name,,}" in
      firefox | firefox-esr)
        say "Firefox comes from Mozilla here"
        /usr/local/lib/linx/install-firefox.sh || rc=1
        continue ;;
    esac
    if special_case "$name"; then
      if [ -n "$REDIRECT" ]; then flats+=("$REDIRECT"); else rc=1; fi
      continue
    fi
    note_about "$name"
    deb="$(ubuntu_name "$name")"
    if in_ubuntu "$deb"; then
      [ "$deb" = "${name,,}" ] || say "$name is $deb in Ubuntu"
      debs+=("$deb")
    elif id="$(flathub_id "$name")" || { flathub_ready && id="$(find_flathub "$name" | awk -F'\t' -v w="${name,,}" '
        { n = split($1, p, "."); if (tolower($2) == w || tolower(p[n]) == w) { print $1; exit } }')" && [ -n "$id" ]; }; then
      say "$name is not in Ubuntu's archive; taking $id from Flathub"
      flats+=("$id")
    else
      warn "Neither Ubuntu nor Flathub has \"$name\" under that name."
      suggest "$name"
      rc=1
    fi
  done
  if [ "${#debs[@]}" -gt 0 ]; then
    say "apt install ${debs[*]}"
    "$APT" "${debs[@]}" | grep -v '^APT_DONE$' || true
    [ "${PIPESTATUS[0]}" = 0 ] || rc=1
  fi
  if [ "${#flats[@]}" -gt 0 ]; then
    install_flatpaks -y "${flats[@]}" || rc=1
  fi
  return "$rc"
}

remove_names() {
  local debs=() name
  for name in "$@"; do debs+=("$(ubuntu_name "$name")"); done
  say "apt remove ${debs[*]}"
  apt-get remove -y "${debs[@]}"
}
search_names() {
  apt-cache search "$@" 2>/dev/null | head -n 30
  flathub_ready && find_flathub "$*" | sed 's/\t/ - /; s/^/flathub: /'
}
upgrade_all() {
  say "apt update && apt upgrade"
  apt-get update -q && apt-get upgrade -y
}
not_this_distro() {
  say "This is Ubuntu: \"$1\" is $2's. Doing the same with apt."
}

# ----------------------------------------------------- the commands' ways
pacman_like() {
  local who="$1" op="" a names=()
  shift
  for a in "$@"; do
    case "$a" in
      --noconfirm | --needed | --asdeps | --asexplicit | --overwrite=* | --sudoloop) ;;
      --sync) op="${op}S" ;;
      --remove) op="${op}R" ;;
      --query) op="${op}Q" ;;
      --refresh) op="${op}y" ;;
      --sysupgrade) op="${op}u" ;;
      --*) ;;
      -*) op="$op${a#-}" ;;
      *) names+=("$a") ;;
    esac
  done
  not_this_distro "$who" "Arch Linux"
  case "$op" in
    *S*s*) search_names "${names[@]}" ;;
    *S*)
      if [ "${#names[@]}" -gt 0 ]; then
        install_names "${names[@]}"
      elif [[ "$op" == *u* ]]; then
        upgrade_all
      else
        say "apt update"
        apt-get update -q
      fi ;;
    *R*) remove_names "${names[@]}" ;;
    *Q*s*) dpkg -l | grep -i -- "${names[0]:-}" ;;
    *Q*) dpkg-query -W -f='${Package} ${Version}\n' "${names[@]}" ;;
    "")
      # "yay NAME" installs; "yay" alone upgrades.
      if [ "${#names[@]}" -gt 0 ]; then install_names "${names[@]}"; else upgrade_all; fi ;;
    *) warn "\"$who $*\" has no equivalent here. apt does this on Ubuntu: apt install, apt remove, apt search."; return 2 ;;
  esac
}

verb_like() {
  local who="$1" from="$2" verb="" a names=()
  shift 2
  for a in "$@"; do
    case "$a" in
      -*) ;;
      *) if [ -z "$verb" ]; then verb="$a"; else names+=("$a"); fi ;;
    esac
  done
  not_this_distro "$who" "$from"
  case "$verb" in
    install | in | add | groupinstall | localinstall) install_names "${names[@]}" ;;
    remove | erase | rm | del | uninstall) remove_names "${names[@]}" ;;
    search | se | find) search_names "${names[@]}" ;;
    update | upgrade | up | dup | distro-sync | refresh) upgrade_all ;;
    list | info | "")
      warn "On Ubuntu: apt list --installed, apt show NAME, apt search WORD." ;;
    *) warn "\"$who $verb\" has no equivalent here. apt does this on Ubuntu: apt install, apt remove, apt search."; return 2 ;;
  esac
}

snap_like() {
  local verb="${1:-}" a names=()
  shift || true
  for a in "$@"; do case "$a" in -*) ;; *) names+=("$a") ;; esac; done
  case "$verb" in
    install)
      say "Snaps need a service that cannot run inside Mobuntu. Looking for the same app in Ubuntu's archive and on Flathub."
      install_names "${names[@]}" ;;
    remove) remove_names "${names[@]}" ;;
    find | search) search_names "${names[@]}" ;;
    *) warn "Snaps cannot run inside Mobuntu. Apps come from Ubuntu's archive (apt) and Flathub (flatpak)."; return 2 ;;
  esac
}

# sudo: options go, variables are set, the command runs.
sudo_like() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -u | -g | -p | -C | -h | -U | -D | -R | -T | --user | --group | --prompt) shift 2 2>/dev/null || shift ;;
      --user=* | --group=* | --prompt=*) shift ;;
      -i | -s | --login | --shell)
        shift
        [ $# -gt 0 ] || exec bash -l ;;
      --) shift; break ;;
      -*) shift ;;
      *=*) export "$1"; shift ;;
      *) break ;;
    esac
  done
  [ $# -gt 0 ] || { echo "usage: sudo command (you are root already: no password, nothing to raise)" >&2; exit 1; }
  case "$1" in
    flatpak)
      shift
      exec "$0" flatpak "$@" ;;
    apt | apt-get)
      # A name apt does not know may be another distribution's.
      if [ "${2:-}" = install ]; then
        "$@" && exit 0
        rc=$?
        "$0" --hint "${@:3}"
        exit "$rc"
      fi ;;
  esac
  exec "$@"
}

# After a failed "apt install": the names it did not know, and what they
# are called here.
hint() {
  local a deb id
  for a in "$@"; do
    case "$a" in -*) continue ;; esac
    in_ubuntu "$a" && continue
    if special_case "$a"; then
      [ -n "$REDIRECT" ] && warn "Install it with: flatpak install $REDIRECT"
      continue
    fi
    deb="$(ubuntu_name "$a")"
    if [ "$deb" != "$a" ] && in_ubuntu "$deb"; then
      warn "\"$a\" is \"$deb\" in Ubuntu: apt install $deb"
    elif id="$(flathub_id "$a")"; then
      warn "\"$a\" is on Flathub: flatpak install $id"
    else
      suggest "$a"
    fi
  done
}

# An unknown command, typed in a terminal.
missing() {
  local c="$1"
  echo "bash: $c: command not found" >&2
  case "$c" in
    */*) return ;;
    systemctl | service | journalctl)
      warn "Mobuntu has no system services (no systemd): programs are started by hand or by the desktop." ;;
    *)
      if in_ubuntu "$c"; then
        warn "Ubuntu has it: apt install $c"
      elif in_ubuntu "$(ubuntu_name "$c")"; then
        warn "Ubuntu has it as $(ubuntu_name "$c"): apt install $(ubuntu_name "$c")"
      fi ;;
  esac
}

# steam: DroidDeck on ARM; Flathub's Steam elsewhere.
steam_like() {
  if [ "$ARM" = 1 ]; then
    say "Steam runs in DroidDeck on this phone. Opening it (or the page to get it from)..."
    /usr/local/bin/linx-phone steam
  elif "$FLATPAK" info com.valvesoftware.Steam >/dev/null 2>&1; then
    exec "$FLATPAK" run com.valvesoftware.Steam "$@"
  else
    warn "Steam is not installed. Install it with: flatpak install com.valvesoftware.Steam"
    return 1
  fi
}

[ -n "$ME" ] || { ME="${1:-}"; shift || true; }
case "$ME" in
  steam) steam_like "$@" ;;
  sudo | doas) sudo_like "$@" ;;
  pacman | yay | paru | pamac | pikaur | trizen) pacman_like "$ME" "$@" ;;
  dnf | yum | microdnf) verb_like "$ME" Fedora "$@" ;;
  zypper) verb_like "$ME" openSUSE "$@" ;;
  apk) verb_like "$ME" Alpine "$@" ;;
  snap) snap_like "$@" ;;
  flatpak)
    if [ "${1:-}" = install ]; then
      shift
      # A file, a URL or another remote: flatpak's own business.
      for a in "$@"; do
        case "$a" in */* | *.flatpakref | *.flatpak | --from | --bundle | --user) exec "$FLATPAK" install "$@" ;; esac
      done
      install_flatpaks "$@"
    else
      exec "$FLATPAK" "$@"
    fi ;;
  install | add | get) install_names "$@" ;;
  remove) remove_names "$@" ;;
  search) search_names "$@" ;;
  --hint) hint "$@" ;;
  --missing) missing "${1:-}" ;;
  *)
    cat >&2 <<'EOF'
linx-pkg: install lines from the web, made to work in Mobuntu.
  linx-pkg install NAME...   from Ubuntu's archive, or Flathub if it is not there
  linx-pkg search WORD       in both
Also answers to: sudo, pacman, yay, paru, dnf, yum, zypper, apk, snap, steam.
EOF
    exit 2 ;;
esac
