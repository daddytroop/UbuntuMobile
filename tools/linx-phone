#!/usr/bin/env python3
"""Hand something to the phone. Runs inside the container.

    linx-phone open URI     the phone opens it: tel: dials, mailto: writes
                            an email, geo: shows a map, a web link opens in
                            the phone's browser
    linx-phone app PACKAGE  start an Android app
    linx-phone quick        the desktop's quick settings (Wi-Fi, Bluetooth,
                            torch, brightness, night light)
    linx-phone screenshot   save the desktop to the phone's Pictures/Screenshots
    linx-phone lock         lock the desktop until the phone's PIN or fingerprint
    linx-phone print FILE   print a PDF with the phone's printers
    linx-phone steam        open DroidDeck (Steam on ARM phones), or the page
                            to get it from
    linx-phone mobuntu      open Mobuntu's own settings (screen size, full
                            screen, performance)
    linx-phone settings PAGE
                            open a page of the phone's settings: battery,
                            internet, wifi, bluetooth, sound or display

The request goes as a JSON line to the app's abstract unix socket (its
name is in /etc/linx/notify-socket, shared with linx-notify.py).
"""

import json
import socket
import sys

SOCKET_FILE = "/etc/linx/notify-socket"


def send(message):
    try:
        with open(SOCKET_FILE) as f:
            name = f.read().strip()
    except OSError:
        sys.exit("the Mobuntu app is not running")
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect("\0" + name)
        s.sendall((json.dumps(message) + "\n").encode())
    except OSError as e:
        sys.exit("cannot reach the Mobuntu app: %s" % e)
    finally:
        s.close()


if __name__ == "__main__":
    if len(sys.argv) == 3 and sys.argv[1] == "open":
        send({"open": sys.argv[2]})
    elif len(sys.argv) == 3 and sys.argv[1] == "app":
        send({"app": sys.argv[2]})
    elif len(sys.argv) == 2 and sys.argv[1] in ("quick", "screenshot", "lock", "steam", "mobuntu"):
        send({sys.argv[1]: True})
    elif len(sys.argv) == 3 and sys.argv[1] == "print":
        send({"print": sys.argv[2]})
    elif len(sys.argv) == 3 and sys.argv[1] == "settings":
        send({"settings": sys.argv[2]})
    else:
        sys.exit(__doc__)
